{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "pnpm build",
  "installCommand": "pnpm install",
  "ignoreCommand": "git diff --quiet ${VERCEL_GIT_PREVIOUS_SHA:-HEAD^} HEAD -- ':/apps/site' ':/package.json' ':/pnpm-lock.yaml' ':/bin' ':/src' ':/assets' ':/scripts/postinstall.mjs' ':/README.md' || exit 1"
}
