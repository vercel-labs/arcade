# Vercel AI Gateway — one key unlocks every provider/model the arcade can play as.
# Create a key at https://vercel.com/<team>/<project>/settings → AI Gateway, then:
#   cp .env.example .env.local   (.env.local is gitignored)
# and paste your key below. The AI SDK reads AI_GATEWAY_API_KEY automatically.
AI_GATEWAY_API_KEY=
