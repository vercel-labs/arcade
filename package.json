{
  "name": "@vercel/arcade",
  "version": "0.1.3",
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "description": "Terminal-rendered ASCII arcade \u2014 3D games in the terminal, powered by Vercel AI Gateway",
  "homepage": "https://vercel-arcade.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vercel-labs/arcade.git"
  },
  "bugs": {
    "url": "https://github.com/vercel-labs/arcade/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "ARCADE_DEV=1 tsx src/arcade/main.ts",
    "snapshot": "ARCADE_DEV=1 tsx src/tools/snapshot.ts",
    "snapshot:png": "sh scripts/snapshot-png.sh",
    "bench": "node --import tsx src/tools/bench.ts",
    "bench:hero": "node --import tsx src/tools/hero-cinematic-bench.ts",
    "bench:hero:matrix": "node --import tsx src/tools/hero-benchmark-matrix.ts",
    "islanders:check": "ARCADE_DEV=1 tsx src/tools/islanders-render-check.ts",
    "islanders:self-play": "node --import tsx src/tools/islanders-self-play.ts",
    "match:run": "ARCADE_TELEMETRY=0 node --import tsx src/tools/match-lab.ts",
    "match:comms": "node --import tsx src/tools/match-lab/communication-report.ts",
    "models:audit": "tsx src/tools/model-compat-report.ts",
    "models:game-audit": "ARCADE_TELEMETRY=0 node --import tsx src/tools/model-game-audit.ts",
    "models:report": "tsx src/tools/model-compat-view.ts",
    "smoke:package": "node scripts/smoke-package.mjs",
    "build:package": "node scripts/build-package.mjs",
    "prepack": "pnpm build:package",
    "build:vercel": "node scripts/build-vercel-output.mjs",
    "watch": "ARCADE_DEV=1 tsx watch src/arcade/main.ts",
    "type-check": "tsc --noEmit",
    "test": "node --import tsx --test '{src,apps}/**/*.test.ts'",
    "postinstall": "node scripts/postinstall.mjs"
  },
  "devDependencies": {
    "@types/node": "22.10.5",
    "@types/ws": "8.18.1",
    "tsx": "4.19.2",
    "typescript": "5.7.3"
  },
  "dependencies": {
    "@ai-sdk/gateway": "4.0.0-beta.113",
    "ai": "6.0.208",
    "ws": "8.21.0",
    "zod": "4.4.3"
  },
  "optionalDependencies": {
    "speaker": "0.5.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "speaker"
    ]
  },
  "bin": {
    "arcade": "./bin/arcade.mjs"
  },
  "exports": {
    ".": { "types": "./dist/public-api.d.ts", "import": "./dist/public-api.js" },
    "./engine": { "types": "./dist/engine/index.d.ts", "import": "./dist/engine/index.js" },
    "./engine/png": { "types": "./dist/engine/texture.d.ts", "import": "./dist/engine/texture.js" },
    "./harness": { "types": "./dist/harness/index.d.ts", "import": "./dist/harness/index.js" },
    "./harness/communication": { "types": "./dist/harness/communication/index.d.ts", "import": "./dist/harness/communication/index.js" },
    "./harness/chess": { "types": "./dist/harness/games/chess/index.d.ts", "import": "./dist/harness/games/chess/index.js" },
    "./harness/islanders": { "types": "./dist/harness/games/islanders/index.d.ts", "import": "./dist/harness/games/islanders/index.js" },
    "./harness/poker": { "types": "./dist/harness/games/poker/index.d.ts", "import": "./dist/harness/games/poker/index.js" },
    "./harness/records": { "types": "./dist/harness/records.d.ts", "import": "./dist/harness/records.js" },
    "./platform": { "types": "./dist/platform/index.d.ts", "import": "./dist/platform/index.js" },
    "./game-visuals": { "types": "./dist/game-visuals/index.d.ts", "import": "./dist/game-visuals/index.js" },
    "./tui": { "types": "./dist/tui/index.d.ts", "import": "./dist/tui/index.js" },
    "./rules": { "types": "./dist/rules/game.d.ts", "import": "./dist/rules/game.js" },
    "./rules/chess": { "types": "./dist/rules/chess/index.d.ts", "import": "./dist/rules/chess/index.js" },
    "./rules/islanders": { "types": "./dist/rules/islanders/index.d.ts", "import": "./dist/rules/islanders/index.js" },
    "./rules/poker": { "types": "./dist/rules/poker/index.d.ts", "import": "./dist/rules/poker/index.js" },
    "./game-visuals/islanders": { "types": "./dist/game-visuals/islanders/index.d.ts", "import": "./dist/game-visuals/islanders/index.js" },
    "./game-visuals/chess": { "types": "./dist/game-visuals/chess/index.d.ts", "import": "./dist/game-visuals/chess/index.js" },
    "./game-visuals/poker": { "types": "./dist/game-visuals/poker/index.d.ts", "import": "./dist/game-visuals/poker/index.js" },
    "./web": { "types": "./dist/web/index.d.ts", "import": "./dist/web/index.js" }
  },
  "files": [
    "bin",
    "scripts/postinstall.mjs",
    "assets",
    "dist",
    "docs/harness.md",
    "docs/architecture/package-boundaries.md",
    "docs/architecture/repository-map.md"
  ],
  "publishConfig": {
    "access": "restricted"
  }
}
