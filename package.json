{
  "name": "arcade",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Terminal-rendered ASCII arcade — 3D games in the terminal, powered by Vercel AI Gateway",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx src/arcade/main.ts",
    "demo": "tsx src/demo/main.ts",
    "snapshot": "tsx src/tools/snapshot.ts",
    "watch": "tsx watch src/arcade/main.ts",
    "type-check": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "22.10.5",
    "@types/ws": "8.18.1",
    "tsx": "4.19.2",
    "typescript": "5.7.3"
  },
  "dependencies": {
    "@ai-sdk/gateway": "4.0.0-beta.113",
    "ai": "6.0.208",
    "speaker": "0.5.5",
    "ws": "8.21.0",
    "zod": "4.4.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["speaker"]
  }
}
