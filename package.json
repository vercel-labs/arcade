{
  "name": "@vercel/arcade",
  "version": "0.1.3",
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "description": "Terminal-rendered ASCII arcade \u2014 3D games in the terminal, powered by Vercel AI Gateway",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "ARCADE_DEV=1 tsx src/arcade/main.ts",
    "snapshot": "ARCADE_DEV=1 tsx src/tools/snapshot.ts",
    "snapshot:png": "sh scripts/snapshot-png.sh",
    "bench": "node --import tsx src/tools/bench.ts",
    "bench:gpu": "node --import tsx src/tools/gpu-bench.ts",
    "catan:check": "ARCADE_DEV=1 tsx src/tools/catan-render-check.ts",
    "models:audit": "tsx src/tools/model-compat-report.ts",
    "models:report": "tsx src/tools/model-compat-view.ts",
    "build:vercel": "node scripts/build-vercel-output.mjs",
    "watch": "ARCADE_DEV=1 tsx watch src/arcade/main.ts",
    "type-check": "tsc --noEmit",
    "test": "node --import tsx --test '{src,apps}/**/*.test.ts'"
  },
  "devDependencies": {
    "@types/node": "22.10.5",
    "@types/ws": "8.18.1",
    "@webgpu/types": "0.1.69",
    "typescript": "5.7.3"
  },
  "dependencies": {
    "@ai-sdk/gateway": "4.0.0-beta.113",
    "ai": "6.0.208",
    "tsx": "4.19.2",
    "ws": "8.21.0",
    "zod": "4.4.3"
  },
  "optionalDependencies": {
    "speaker": "0.5.5",
    "webgpu": "0.4.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "speaker",
      "webgpu"
    ]
  },
  "bin": {
    "arcade": "./bin/arcade.mjs"
  },
  "files": [
    "bin",
    "assets",
    "src",
    "!src/tools",
    "!src/**/*.test.ts"
  ],
  "publishConfig": {
    "access": "restricted"
  }
}
