# Heavy chess assets: only chess_blender/ is loaded at runtime. The raw Blender
# model sources and any superseded sliced/decimated sets stay local (not shipped).
assets/chess_pieces.obj
assets/chess_pieces.glb
assets/chess/
assets/chess_decimated/

# hands-free voice diagnostic logs (local only)
.audio-logs/
.vercel

# git worktrees created by the agent harness (local only)
.claude/worktrees/
*.tgz

# local-only clutter: nested checkouts of other repos, and a stray repo-local
# pnpm store (arcade uses the global store — this only appears when another
# project's newer pnpm drops a v11 store here)
.worktrees/
.pnpm-store/
